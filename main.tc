// declare global players: dict[Player];
declare global playerCount: num;
declare global rooms: list[Room];
declare global roomGrid: dict[Room];

declare global camera: Camera;
declare global display: screenDisplay;

declare global "player_%var(i)": Player;
declare global "player_%var(playerCount)": Player;

gameevent startup {
    true = 1;
    false = 0;

    camera = Camera();
    camera.teleport(loc(51.5, 53, 49.5, 55));
    display = screenDisplay(vec(0, 40, -50), 50, camera);

    line allDoors: list[vec] = [vec(1, 0, 0), vec(0, 0, 1), vec(-1, 0, 0), vec(0, 0, -1)];

    line foyer = Room("Foyer", "spruce_planks,spruce_planks,spruce_planks,spruce_planks,spruce_planks,spruce_planks,spruce_planks,spruce_planks,spruce_planks", "G", allDoors);
    line basement = Room("Basement", "black_concrete,black_concrete,light_gray_concrete,black_concrete,light_gray_concrete,light_gray_concrete,light_gray_concrete,light_gray_concrete,light_gray_concrete", "B", allDoors);


    foyer.place(Pos(0, 1, 0));
    roomGrid[Pos(0, 1, 0).toDictKey()] = foyer;
    basement.place(Pos(0, 0, 0));
    roomGrid[Pos(0, 0, 0).toDictKey()] = basement;

    repeat {
        basement.drawDoors(Pos(0, 0, 0));
        wait;
    }
}

playerevent join {
    wait;
    call "setCloudHeight"();
    player.setToSpectatorMode();
    camera.spectate();

    line plr = Player("%default", "%uuid", Pos(0, 0, 0));
    playerCount++;
    global "player_%var(playerCount)" = plr;
    drawPlayerCard(display, 110 - (44 * (playerCount - 1)), "%default");
    // players["%uuid"] = plr;
    // Player("Bob", "12095784", Pos(0, 0, 0));
    // Player("Bob", "12095784", Pos(0, 0, 0));
    // Player("Bob", "12095784", Pos(0, 0, 0));
}

function setCloudHeight() {
    player.setNumEnvOption(-10000, option="Cloud height");
}