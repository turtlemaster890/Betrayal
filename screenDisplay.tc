type screenDisplay: {
    offset: vec,
    size: num,
    ridingUUID: str,
    owner: str,
    entityUUIDs: dict[str]
};

extend screenDisplay {
    function constructor(offset: vec, size: num, ridingUUID: str, owner: str): screenDisplay {
        return {
            offset: offset,
            size: size,
            ridingUUID: ridingUUID,
            owner: owner,
            entityUUIDs: {}
        } as screenDisplay;
    }

    // Final translation vector for an element (offset + local offset + text bias correction).
    function translationFor(self: var[screenDisplay], localOffset: vec, rotation: num, sizeFactor: num): vec {
        // Define local bias (e.g., shifting down relative to the text's own orientation)
        line biasX = 0.041 - 0.016 * num.log(self["size"] * sizeFactor, 2.718281828459045235360287471352);
        // line biasY = -0.12;
        line biasY = -0.2 + 0.023 * num.log(self["size"] * sizeFactor, 2.718281828459045235360287471352);

        // Rotate the bias vector to match the text's rotation angle
        line rotBiasX = biasX * num.cos(rotation) - biasY * num.sin(rotation);
        line rotBiasY = biasX * num.sin(rotation) + biasY * num.cos(rotation);
        line correction = vec(rotBiasX, rotBiasY, 0) * self["size"] * sizeFactor;

        return self["offset"] + localOffset + correction;
    }

    function addElement(self: var[screenDisplay], id: str, text: txt, localOffset?: vec = vec(0, 0, 0), rotation?: num = 0, sizeFactor: num = 1) {
        line translation = self.translationFor(localOffset, rotation, sizeFactor);

        game.spawnTextDisplay(loc(0, 0, 0), text);
        lastEntity.ride(self["ridingUUID"]);

        lastEntity.setDisplayTranslation(translation);
        lastEntity.setDisplayScale(self["size"] * sizeFactor, self["size"] * sizeFactor, self["size"] * sizeFactor);
        lastEntity.setDisplayRotationFromAxisAngle(vec(0, 0, 1), rotation);
        lastEntity.setTextDisplaySeeThrough();
        lastEntity.setTextDisplayBackground("#000000", 0);
        lastEntity.setDisplayViewRange(1);
        line uuids = self["entityUUIDs"];
        uuids[id] = lastEntity.uuid;
        self["entityUUIDs"] = uuids;
        hudHideFromOthers(lastEntity.uuid, self["owner"]);
    }

    // Move an existing element without respawning it. Pass the same rotation/sizeFactor it was created with.
    function moveElement(self: var[screenDisplay], id: str, localOffset: vec, rotation?: num = 0, sizeFactor: num = 1) {
        line translation = self.translationFor(localOffset, rotation, sizeFactor);
        select entitiesByUUID(self["entityUUIDs"][id]);
        entity.setDisplayTranslation(translation);
        select reset;
    }

    function removeAll(self: var[screenDisplay]) {
        // line uuidsCopy = self["entityUUIDs"];
        for (line id, line uuid of self["entityUUIDs"]) {
            select entitiesByUUID(uuid);
            entity.remove();
            select reset;
            // line uuids = self["entityUUIDs"];
            // uuids.remove(id);
            // self["entityUUIDs"] = uuids;
        }
        self["entityUUIDs"] = {};
    }

    function removeById(self: var[screenDisplay], id: str) {
        select entitiesByUUID(self["entityUUIDs"][id]);
        entity.remove();
        select reset;
        line uuids = self["entityUUIDs"];
        uuids.remove(id);
        self["entityUUIDs"] = uuids;
    }
}

function inCircleFromSideLength(radius: num): num {
    return radius / 10 * 6.88190960236;
}

function drawPlayerCard(display: var[screenDisplay], xOffset: num, plr: str) {
    line k = display["size"] / 50;
    display.addElement("head", txt.parseExpression("<head:%var(plr)>"), vec(xOffset, 0, 0));
    display.addElement("name", s"<#838f6e><bold>%var(plr)", vec(xOffset, -10 * k, 0), 0, 0.2);
    
    line rad = inCircleFromSideLength(37.5 * (display["size"] / 100));
    line descriptorRad = inCircleFromSideLength(50 * (display["size"] / 100));
    
    line descriptors: list[txt] = [s"Might", s"Speed", s"Knowledge", s"Sanity"];
    line statValues: list[txt] = [s"💀", s"2", s"3", s"4", s"5", s"6", s"6"];

    repeat(line i to 4) {
        line angle = (i * (360 / 5) - 90); 
        line x = num.cos(angle);
        line y = num.sin(angle);

        line baseAngle = angle + 90;
        line adj = 1.015;
        if (y > 0) {
            baseAngle += 180;
            adj = 0.985;
        }

        // Draw descriptor and its background
        display.addElement("stat_%var(plr)_%var(i)_descriptor_bg", txt.parseExpression("<sprite:blocks:block/black_concrete>".repeat(6)), vec(x * descriptorRad * adj + xOffset, y * descriptorRad * adj, 0), baseAngle, 0.25);
        display.addElement("stat_%var(plr)_%var(i)_descriptor", descriptors[i], vec(x * descriptorRad + xOffset, y * descriptorRad, 0), baseAngle, 0.2);

        // Single background strip for the stats
        display.addElement("stat_%var(plr)_%var(i)_bg", txt.parseExpression("<sprite:blocks:block/black_concrete>".repeat(7)), vec(x * rad * adj + xOffset, y * rad * adj, 0), baseAngle, 0.25);

        // Spawn individual numbers, rotated 90° for vertical text
        line verticalAngle = baseAngle + 90 + (180 * (i % 2));
        
        repeat(line j to statValues.len()) {
            // Offset each number along the vertical line
            line spacingOffset = ((j - (statValues.len() / 2)) * 2.25 * (1 - 2 * (i % 2)) - (1 - 2 * (i % 2))) * k;
            
            line statX = (x * rad) + (-num.cos(baseAngle) * spacingOffset) + xOffset;
            line statY = (y * rad) + (-num.sin(baseAngle) * spacingOffset);
            // Individual number display element
            display.addElement("stat_%var(plr)_%var(i)_%var(j)", statValues[j], vec(statX, statY, 0), verticalAngle, 0.2);
        }
    }
}